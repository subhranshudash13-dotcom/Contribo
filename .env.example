# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Optional explicit DB name (overrides path segment in URI; default: contribo)
MONGODB_DB=contribo

# Auth (Generate with: npx auth secret)
# Required in production; min 16 characters. Never use "default_secret".
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_auth_secret_here
# Canonical app origin — used for CSRF origin checks and OAuth callbacks
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
AUTH_GITHUB_ID=your_github_id_here
AUTH_GITHUB_SECRET=your_github_secret_here

# Google OAuth
AUTH_GOOGLE_ID=your_google_id_here
AUTH_GOOGLE_SECRET=your_google_secret_here

# AI Providers (server-only — never NEXT_PUBLIC_)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=openai

# App Config (public-safe only)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GSOC_YEAR=2026
# Optional analytics — public GTM container id only
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Offline build settings
NEXT_FONT_GOOGLE_MOCK=1
